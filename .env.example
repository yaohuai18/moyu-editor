# 复制这个文件为 .env，然后把等号后面填上你自己的值。
# .env 已被 .gitignore 忽略，不会提交到 Git。
#
# ==========================================================
# 生产环境（部署平台）上要配的变量就这四个：
#
#   DATABASE_URL   生产数据库连接串（不要用开发那个库）
#   AUTH_SECRET    至少 32 位的随机串，生成方法见下面
#   AI_API_KEY     AI 服务密钥
#   AI_MODEL       模型名，例如 deepseek-chat
#
# 再按情况加一个（反向代理后面必须要有其中一个）：
#   AUTH_URL="https://你的域名"    或    AUTH_TRUST_HOST="true"
#
# ⚠️ 三条铁律：
#   1. 变量名绝对不要加 NEXT_PUBLIC_ 前缀 —— 加了就会被编译进浏览器代码，
#      等于把密钥直接公开。AI_API_KEY 永远留在服务端。
#   2. 不要把 .env 文件传上服务器；在平台的「环境变量」里逐条填。
#   3. 生产环境不要继续用演示账号 demo@moyu.local 和演示数据。
# ==========================================================
#
# 优先级（高 → 低）：进程环境变量 > .env.production.local > .env.local >
#                    .env.production / .env.development > .env
# ⚠️ 也就是说，如果你在启动命令前面写 AI_API_KEY=xxx，它会盖掉 .env 里的值。
#    这招可以用来临时试新 Key，但也容易「明明改了 .env 却不生效」——先想到这条。

# 本地开发数据库（SQLite 文件，位于 prisma/dev.db）
DATABASE_URL="file:./dev.db"

# ===== AI 服务（只在服务器端使用，不会暴露给浏览器）=====
# 以 DeepSeek 为例：https://platform.deepseek.com 申请
#
# ⚠️ 绝对不要写成 NEXT_PUBLIC_AI_API_KEY —— NEXT_PUBLIC_ 开头的变量会被
#    编译进浏览器里的 JS，等于把 Key 直接印在网页上给所有人看。
AI_API_KEY=""
AI_BASE_URL="https://api.deepseek.com"
AI_MODEL="deepseek-chat"
# 可选：单次输出上限（DeepSeek 上限 8192，不填默认 8000）
# AI_MAX_TOKENS="8000"
#
# 单次输入上限写在代码里，不在这里配：
#   src/lib/ai-limits.ts → AI_MAX_INPUT_CHARS = 100000（字符数）
#                          AI_MAX_INPUT_WORDS = 50000（去空白后的字数）
# 每人每分钟的调用次数上限写在：
#   src/app/api/ai/edit/route.ts → RATE_LIMIT = 10

# ===== 登录会话加密密钥（Auth.js）=====
# 生成方法（任选一条，在项目根目录执行）：
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 换了它，所有人都会被登出，这正常。
AUTH_SECRET=""

# 本地跑在 http://localhost:3001 时留 true；
# 部署到正式域名后改成 AUTH_URL="https://你的域名"
AUTH_TRUST_HOST="true"

# ===== 运维脚本的可选项（不配也有合理默认值）=====
# 日常巡检（npm run ops:daily）用哪个账号测登录和保存链路。
# 不配时用演示账号 demo@moyu.local —— 上线删演示账号前记得配一个专用账号。
# OPS_EMAIL="probe@example.com"
# OPS_PASSWORD="这里填你的值"
# 巡检目标地址（默认 http://127.0.0.1:3001，也可以只配 OPS_PORT）
# OPS_BASE_URL="http://127.0.0.1:3001"
# OPS_PORT="3001"
#
# AI 用量报表（npm run ops:ai）的费用估算单价：元 / 百万字符。
# 默认按 DeepSeek token 单价粗折算（输入 1.5 / 输出 5），只是量级参考。
# AI_COST_INPUT_PER_M="1.5"
# AI_COST_OUTPUT_PER_M="5"
