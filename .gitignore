# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma / 本地数据库
# 注意：WAL 模式下 -wal / -shm 这两个文件里也是真实数据，必须一起忽略
/prisma/*.db
/prisma/*.db-journal
/prisma/*.db-wal
/prisma/*.db-shm
/prisma/*.sqlite
/prisma/*.sqlite3

# 数据库备份（里面是真实作品数据，绝不能进 Git）
/backups

# 运维报告（生成物，且含探测账号邮箱）
/ops-reports

# 历次阶段的验收脚本与浏览器用户配置（合计约 560MB 生成物）
/_p9
/_p10
/_p11
/_edgeprofile

# 历次构建产物残留（Next 的 .next 已在上方 /`.next/` 排除）
/.next-old-*
/.next-stale-*

# 一键验证日志（生成物，勿提交）
/verify.log
